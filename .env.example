# Copy to .env and fill in. These are read from the process environment.

# OpenAI (required for summarisation)
OPENAI_API_KEY=sk-...

# Spotify Web API (Client Credentials flow). Optional: if unset, podsummary
# falls back to using YouTube as the episode source.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key. Optional: if unset (or youtube.prefer = yt_dlp),
# the keyless yt-dlp backend is used to list channel videos.
YOUTUBE_API_KEY=
